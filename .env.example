# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Datenbank (wird von Docker Compose gesetzt)
DATABASE_URL=postgresql://amir:localdev@localhost:5433/ironcoach

# Strava OAuth
# Registriere deine App unter: strava.com/settings/api
STRAVA_CLIENT_ID=deine_client_id
STRAVA_CLIENT_SECRET=dein_client_secret
STRAVA_VERIFY_TOKEN=ironcoach_webhook_secret   # selbst gewählt, beliebiger String

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# Willkommensmail (optional)
# Fehlen MAIL_HOST oder MAIL_FROM, wird keine Mail verschickt — die
# Registrierung funktioniert trotzdem, der Versand wird nur protokolliert.
MAIL_HOST=smtp.beispiel.de
MAIL_PORT=587
MAIL_USER=coach@beispiel.de
MAIL_PASSWORD=dein_smtp_passwort
MAIL_FROM=coach@beispiel.de
MAIL_FROM_NAME=IronCoach
MAIL_STARTTLS=true       # Port 587; für Port 465 stattdessen MAIL_SSL=true
MAIL_SSL=false

# Pflicht: Ohne festes Geheimnis werden alle Nutzer bei jedem Neustart
# abgemeldet. Erzeugen mit: openssl rand -hex 32
JWT_SECRET=

# Woher das Frontend kommen darf, kommagetrennt. Ohne passenden Eintrag
# blockiert der Browser jede Anfrage.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
